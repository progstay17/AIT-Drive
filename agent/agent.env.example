# Folder on this PC that holds ALL drives (one subfolder per account) and the accounts database (.ait/)
STORAGE_ROOT=C:\cloud-drive\storage
# Listen only locally; the tunnel (cloudflared/tailscale) reaches it
AGENT_HOST=127.0.0.1
AGENT_PORT=4001
# Shared secret between the agent and the web app (min 24 chars). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_STRING
# Optional. false (default) = the total of all user quotas can never exceed the disk capacity.
# true = allow promising more than the disk really has (thin provisioning).
ALLOW_OVERBOOK=false
