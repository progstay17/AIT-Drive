# Cara mudah: jalankan agent\setup-agent.bat (memilih folder lewat jendela dan membuat file ini).
# Folder di PC ini yang menyimpan SEMUA file pengguna (satu subfolder per akun)
STORAGE_ROOT=C:\cloud-drive\storage
# Hanya didengarkan lokal; tunnel (cloudflared/tailscale) yang menjangkaunya
AGENT_HOST=127.0.0.1
AGENT_PORT=4001
# Rahasia bersama dengan web di Coolify (min 24 karakter). Buat: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_STRING
