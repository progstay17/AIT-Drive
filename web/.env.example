# Set these as Environment Variables in Coolify
# Akun owner (bebas kamu tentukan; tidak harus sama dengan di PC)
ADMIN_USER=han
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# min 32 chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=CHANGE_ME_64_HEX_CHARS
# Public URL of the tunnel that points to the PC agent (no trailing slash)
AGENT_URL=https://pc-agent.example.com
# Must equal AGENT_TOKEN in agent.env (the only value that must match the PC)
AGENT_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_STRING
# true when served over HTTPS (Coolify does this). Use false only for local http testing.
COOKIE_SECURE=true
SESSION_HOURS=168
PORT=3000
# Tempat akun, kuota, dan izin disimpan. Di Docker/Coolify = /data dan HARUS dipasangi Persistent Storage.
# Lokal default: web/data
#DATA_DIR=/data
# false (default) = total kuota semua akun tidak boleh melebihi kapasitas disk PC. true = boleh (thin provisioning).
#ALLOW_OVERBOOK=false
