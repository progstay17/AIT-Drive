# Set these as Environment Variables in Coolify
ADMIN_USER=han
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# min 32 chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=CHANGE_ME_64_HEX_CHARS
# Public URL of the tunnel that points to the PC agent (no trailing slash)
AGENT_URL=https://pc-agent.example.com
# Must equal AGENT_TOKEN in agent.env
AGENT_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_STRING
# true when served over HTTPS (Coolify does this). Use false only for local http testing.
COOKIE_SECURE=true
SESSION_HOURS=168
PORT=3000
